# Copy to .env and fill in. Never commit .env.

# Work-order API database (managed MySQL, e.g. TiDB Cloud Serverless or Aiven)
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/workloop_orders?sslaccept=strict"

# Auth
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"

# Message broker (managed RabbitMQ, e.g. CloudAMQP) — needed from week 4
RABBITMQ_URL="amqps://USER:PASSWORD@HOST/VHOST"
