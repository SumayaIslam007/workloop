# Copy this file to .env (same folder) and fill in the values. Never commit .env.

NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# The web app's origin, allowed to call the API with cookies
CORS_ORIGIN=http://localhost:5173

# MySQL 8 connection string: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# URL-encode special characters in the password (e.g. @ becomes %40).
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/workloop_orders"
# Managed cloud databases require TLS
DATABASE_SSL=true
# Only needed if your provider gives you its own CA certificate file (e.g. Aiven)
# DATABASE_SSL_CA=./certs/ca.pem

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
